# Credential-free reference. The application reads process environment only;
# it does not automatically load this file or any .env file.
# APP_ENV and AUTH_MODE require explicit selection. Blank AUTH_MODE fails startup.
# companyos_dev target is approved; creation/access remain separately gated.
# companyos_test is unapproved; company_db is forbidden. No DB connection exists.
APP_ENV=local
API_BIND_HOST=127.0.0.1
EXPECTED_DATABASE_NAME=companyos_dev
DATABASE_URL=
MIGRATION_DATABASE_URL=
TEST_DATABASE_URL=
DB_TLS_CA_FILE=

# Choose development-stub explicitly for local/test synthetic configuration.
# Provider mode is rejected until real authentication is implemented/reviewed.
# No business authentication or browser-controlled role switching is implemented.
AUTH_MODE=
DEV_IDENTITY_ROLE=Viewer
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
# Provider settings, CORS, DB TLS and logging configuration are future work;
# these reference entries are not consumed by the current settings model.
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Owner-approved semantics for NEW approved MVP data, never legacy conversion.
SALARY_CURRENCY=USD
SALARY_PERIOD=monthly
BUDGET_CURRENCY=USD
DATASET_CONTEXT=synthetic-mvp
LOG_LEVEL=INFO
